# ============================================================
# AI Usage Refresh - Configuration Template
# ============================================================
# In GitHub, set these as Secrets and Variables:
#   Settings > Secrets and variables > Actions
#
# Secrets (encrypted):
#   - API_KEY         Your Coding Plan API key
#
# Variables (non-secret):
#   - API_PROVIDER    Provider name
#   - API_BASE_URL    API endpoint
#   - MODEL           Model name
# ============================================================

# --- Provider ---
# Supported values:
#   openai              - OpenAI / any OpenAI-compatible Coding Plan endpoint
#   anthropic           - Anthropic / any Anthropic-compatible Coding Plan endpoint
#   custom              - Custom endpoint (requires API_BASE_URL)
API_PROVIDER=openai

# --- API Key (set as GitHub Secret!) ---
# NEVER put your actual key here. Use GitHub Secrets.
# API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Base URL (set as GitHub Variable) ---
# Coding Plan specific endpoints:
#
# ZAI (智谱) Coding Plan:
#   API_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
#   API_PROVIDER=openai
#
# Alibaba Cloud (阿里云) Coding Plan (OpenAI compatible):
#   API_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
#   API_PROVIDER=openai
#   API_KEY format: sk-sp-xxxxx (Coding Plan exclusive key, NOT the regular bailian key)
#
# Alibaba Cloud (阿里云) Coding Plan (Anthropic compatible):
#   API_BASE_URL=https://coding.dashscope.aliyuncs.com/apps/anthropic
#   API_PROVIDER=anthropic
#   API_KEY format: sk-sp-xxxxx
#
# ChatGPT Plan:
#   API_BASE_URL=https://api.openai.com/v1
#   API_PROVIDER=openai
#
# Claude / Anthropic:
#   API_BASE_URL=https://api.anthropic.com/v1
#   API_PROVIDER=anthropic
#
# Other providers: check your Coding Plan dashboard for the
# exclusive API Key and Base URL.
API_BASE_URL=

# --- Model (optional) ---
# Check your Coding Plan for supported models.
# Leave empty to use default.
MODEL=

# --- Cron Schedule ---
# Edit .github/workflows/refresh.yml to change the interval.
# Default: '0 */5 * * *' (every 5 hours)
#
# Common intervals:
#   Every 1 hour:  '0 */1 * * *'
#   Every 2 hours: '0 */2 * * *'
#   Every 3 hours: '0 */3 * * *'
#   Every 4 hours: '0 */4 * * *'
#   Every 5 hours: '0 */5 * * *'
#   Every 6 hours: '0 */6 * * *'
#   Every 8 hours: '0 */8 * * *'
#   Every 12 hours: '0 */12 * * *'
#   Custom:        Use https://crontab.guru to generate
